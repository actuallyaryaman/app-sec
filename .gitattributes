# Containers require LF even when Git is configured for Windows CRLF checkouts.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
.env.example text eol=lf
**/.env.example text eol=lf
