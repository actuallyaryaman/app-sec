# Copy to .env using your shell. Target architecture is independent of host CPU.
TARGET_ARCH=amd64
# Scanner runtime platform; default gives a consistent x86-64 baseline.
# On ARM this needs Docker-provided amd64 emulation; see repository README.
SCANNER_PLATFORM=linux/amd64
DVWA_IMAGE=docker.io/vulnerables/web-dvwa:latest
GRAFANA_IMAGE=docker.io/grafana/grafana:8.1.5
# Set full SHA after first clone; existing clone never auto-fetches.
DVWA_REF=HEAD
OFFLINE=0
# Optional /lab/runs/<trivy-run>/database path; use together with OFFLINE=1.
DB_SNAPSHOT=
LAB_UID=1000
LAB_GID=1000
# For stronger pinning replace service image tags in compose.yaml with recorded digests.
